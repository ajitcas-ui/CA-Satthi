rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict owner-only admin gate using verified Firebase Auth email token
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'ajitsinghca9@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // 1. User Profiles: /users/{userId} — Strict PII protection
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();

      // Students can only register themselves with 'student' role and unpaid state
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().id == userId &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().email is string && incoming().email.size() <= 150 &&
        (isAdmin() || (
          incoming().role == 'student' &&
          (!('hasPaidPass' in incoming()) || incoming().hasPaidPass == false) &&
          (!('membershipStatus' in incoming()) || incoming().membershipStatus == 'unpaid') &&
          (!('isSuspended' in incoming()) || incoming().isSuspended == false) &&
          (!('canUploadNotes' in incoming()) || incoming().canUploadNotes == false)
        ));

      // Students cannot self-approve membership, extend expiry, change role, grant upload permission, or unsuspend themselves
      allow update: if isValidId(userId) && (
        isAdmin() || (
          isOwner(userId) &&
          !incoming().diff(existing()).affectedKeys().hasAny([
            'role',
            'membershipStatus',
            'hasPaidPass',
            'subscriptionExpiresAt',
            'passExpiry',
            'isSuspended',
            'suspensionReason',
            'canUploadNotes',
            'email',
            'id',
            'createdAt'
          ])
        )
      );

      allow delete: if isAdmin();

      match /studySessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /testResults/{testResultId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wrongQuestions/{questionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /studyTasks/{taskId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /revisionReminders/{reminderId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /chapterProgress/{chapterId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      function isValidAIChatMessage(data) {
        return data.keys().hasAll(['id', 'userId', 'role', 'content', 'paperId', 'language', 'createdAt']) &&
          data.keys().hasOnly(['id', 'userId', 'role', 'content', 'paperId', 'language', 'imageUrl', 'createdAt']) &&
          data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
          data.userId is string && data.userId == userId &&
          data.role in ['user', 'model'] &&
          data.content is string && data.content.size() > 0 && data.content.size() <= 16000 &&
          data.paperId in ['all', 'paper1', 'paper2', 'paper3', 'paper4'] &&
          data.language in ['en', 'hi', 'hinglish'] &&
          data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
          (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 250000));
      }

      match /aiChats/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isValidId(messageId) && (
          isAdmin() || (isOwner(userId) && isValidAIChatMessage(incoming()))
        );
        allow update: if isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Non-PII Live Study Presence: /studyPresence/{userId}
    match /studyPresence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && isOwner(userId) &&
        incoming().userId == request.auth.uid &&
        incoming().displayName is string && incoming().displayName.size() <= 80 &&
        incoming().isStudying is bool &&
        !('phone' in incoming()) &&
        !('email' in incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 3. Single Common Student Group Posts & Replies: /posts/{postId}
    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && isValidId(postId) &&
        incoming().authorId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 250 &&
        incoming().content is string && incoming().content.size() <= 3000;

      allow update: if isAdmin() || (
        isSignedIn() && (
          (existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'isResolved', 'replies'])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(replyId) &&
          incoming().authorId == request.auth.uid &&
          incoming().content is string && incoming().content.size() <= 2000;
        allow update: if isAdmin() || (
          isSignedIn() && (
            (existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy'])
          )
        );
        allow delete: if isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
      }
    }

    // 4. Moderation Reports: /moderationReports/{reportId}
    match /moderationReports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().reportedByUid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && existing().reportedByUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 5. Official Exam Announcements: /examAnnouncements/{announcementId}
    match /examAnnouncements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Payment Requests: /paymentRequests/{paymentId}
    match /paymentRequests/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(paymentId) &&
        incoming().studentId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().utr is string && incoming().utr.size() >= 8 && incoming().utr.size() <= 40 &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().studentMobile is string && incoming().studentMobile.size() >= 10 && incoming().studentMobile.size() <= 15 &&
        (!('screenshotUrl' in incoming()) || (incoming().screenshotUrl is string && incoming().screenshotUrl.size() <= 750000));
      allow update, delete: if isAdmin();
    }

    function canStudentUploadNotes() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canUploadNotes == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended != true;
    }

    // 7. Notifications: /notifications/{notifId}
    match /notifications/{notifId} {
      allow create: if isSignedIn() && isValidId(notifId) && (
        isAdmin() ||
        (incoming().recipientId == 'admin' && incoming().type == 'payment_submitted') ||
        (incoming().recipientId == 'admin' && incoming().type == 'note_submitted' && canStudentUploadNotes())
      );
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.recipientId == request.auth.uid ||
          resource.data.recipientId == 'all'
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.recipientId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin();
    }

    // 8. Admin Analytics Events: /analyticsEvents/{eventId}
    match /analyticsEvents/{eventId} {
      allow create: if isValidId(eventId) &&
        incoming().eventType in ['visit', 'login', 'signup', 'study_session', 'payment_submit'] &&
        incoming().visitorId is string && incoming().visitorId.size() <= 80 &&
        incoming().date is string && incoming().date.size() == 10;
      allow read, update, delete: if isAdmin();
    }

    // 9. Admin Audit Logs: /auditLogs/{logId}
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 10. Admin UPI Configuration: /upiConfig/{configId}
    match /upiConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Exam Countdown: /examCountdown/{configId}
    match /examCountdown/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Admin-managed Syllabus Chapters, Questions & Study Materials
    match /subjectChapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customQuestions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. PDF Study Materials & Notes Approval Library: /noteMaterials/{noteId}
    function isValidNoteMaterialCreate(data) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'paperId', 'chapterId', 'chapterNumber',
          'chapterTitle', 'attempt', 'category', 'fileName', 'storageFileName',
          'fileUrl', 'fileSizeBytes', 'mimeType', 'uploaderId', 'uploaderName',
          'uploaderRole', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'paperId', 'chapterId', 'chapterNumber',
          'chapterTitle', 'attempt', 'category', 'fileName', 'storageFileName',
          'fileUrl', 'fileSizeBytes', 'mimeType', 'uploaderId', 'uploaderName',
          'uploaderEmail', 'uploaderRole', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 1500 &&
        data.paperId in ['paper1', 'paper2', 'paper3', 'paper4'] &&
        data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() <= 120 &&
        data.chapterNumber is number && data.chapterNumber >= 1 && data.chapterNumber <= 50 &&
        data.chapterTitle is string && data.chapterTitle.size() > 0 && data.chapterTitle.size() <= 200 &&
        data.attempt in ['January 2027', 'May 2027', 'Both'] &&
        data.category in [
          'Chapter-wise Notes',
          'Handwritten Notes',
          'Practice Material',
          'Important Questions',
          'Previous Year Questions',
          'Mock Tests'
        ] &&
        data.fileName is string && data.fileName.size() > 4 && data.fileName.size() <= 200 &&
        data.storageFileName is string && data.storageFileName.size() > 4 && data.storageFileName.size() <= 200 &&
        data.fileUrl is string && data.fileUrl.size() > 0 && data.fileUrl.size() <= 500 &&
        data.fileSizeBytes is number && data.fileSizeBytes > 0 && data.fileSizeBytes <= 15728640 &&
        data.mimeType == 'application/pdf' &&
        data.uploaderId == request.auth.uid &&
        data.uploaderName is string && data.uploaderName.size() > 0 && data.uploaderName.size() <= 100 &&
        (!('uploaderEmail' in data) || (data.uploaderEmail is string && data.uploaderEmail.size() <= 150)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /noteMaterials/{noteId} {
      allow get, list: if isAdmin() ||
        resource.data.status == 'approved' ||
        (isSignedIn() && resource.data.uploaderId == request.auth.uid);

      allow create: if isValidId(noteId) && (
        (isAdmin() && incoming().id == noteId) ||
        (canStudentUploadNotes() &&
          incoming().id == noteId &&
          incoming().uploaderRole == 'student' &&
          incoming().status == 'pending' &&
          isValidNoteMaterialCreate(incoming()))
      );

      allow update, delete: if isAdmin();
    }
  }
}
