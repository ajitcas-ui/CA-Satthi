{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student or Admin profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "targetAttempt": { "type": "string", "maxLength": 50 },
        "targetYear": { "type": "number" },
        "city": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 500 },
        "avatar": { "type": "string", "maxLength": 20 },
        "joinedGroupIds": { "type": "array" },
        "privacyHideCity": { "type": "boolean" },
        "privacyHideAttempt": { "type": "boolean" },
        "membershipStatus": { "type": "string", "enum": ["active", "pending", "expired", "unpaid"] },
        "hasPaidPass": { "type": "boolean" },
        "subscriptionExpiresAt": { "type": "string" },
        "passExpiry": { "type": "string" },
        "paymentReference": { "type": "string", "maxLength": 40 },
        "isSuspended": { "type": "boolean" },
        "suspensionReason": { "type": "string", "maxLength": 300 },
        "dailyGoalMinutes": { "type": "number" },
        "studyMinutesTotal": { "type": "number" },
        "studyStreak": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "learningPoints": { "type": "number" },
        "totalQuestionsAttempted": { "type": "number" },
        "totalQuestionsCorrect": { "type": "number" },
        "canUploadNotes": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Student active study session time and accuracy log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "paperId": { "type": "string" },
        "chapterId": { "type": "string" },
        "activityType": { "type": "string", "enum": ["practice", "mock", "notes", "planner", "doubtSolver", "dailyChallenge", "general"] },
        "durationMinutes": { "type": "number" },
        "questionsAttempted": { "type": "number" },
        "questionsCorrect": { "type": "number" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": "string" }
      },
      "required": ["id", "userId", "date", "activityType", "durationMinutes"]
    },
    "StudyPresence": {
      "title": "StudyPresence",
      "description": "Non-PII live study room presence heartbeat for single common group",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 80 },
        "avatar": { "type": "string", "maxLength": 20 },
        "targetAttempt": { "type": "string", "maxLength": 50 },
        "activePaperId": { "type": "string" },
        "activeTopic": { "type": "string", "maxLength": 120 },
        "isStudying": { "type": "boolean" },
        "sessionStartedAt": { "type": "string" },
        "lastHeartbeatAt": { "type": "string" }
      },
      "required": ["userId", "displayName", "isStudying", "lastHeartbeatAt"]
    },
    "TestResult": {
      "title": "TestResult",
      "description": "Official mock test attempt scorecard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "testTitle": { "type": "string", "maxLength": 200 },
        "paperId": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "attempted": { "type": "number" },
        "correct": { "type": "number" },
        "incorrect": { "type": "number" },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "testId", "score"]
    },
    "WrongQuestion": {
      "title": "WrongQuestion",
      "description": "Wrong questions notebook entry",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string" },
        "failedCount": { "type": "number" },
        "lastAttemptDate": { "type": "string" },
        "lastSelectedOption": { "type": "number" },
        "cleared": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["questionId", "userId", "paperId", "failedCount"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Bookmarked question reference",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["questionId", "userId"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Daily study checklist task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "paperId": { "type": "string" },
        "chapter": { "type": "string", "maxLength": 200 },
        "durationMinutes": { "type": "number" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "title", "paperId", "completed"]
    },
    "RevisionReminder": {
      "title": "RevisionReminder",
      "description": "Spaced repetition revision reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string" },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "intervalDays": { "type": "number" },
        "dueDate": { "type": "string" },
        "completed": { "type": "boolean" }
      },
      "required": ["id", "userId", "paperId", "chapterTitle", "intervalDays", "dueDate"]
    },
    "ChapterProgress": {
      "title": "ChapterProgress",
      "description": "Syllabus chapter mastery state",
      "type": "object",
      "properties": {
        "chapterId": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "revising", "mastered"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["chapterId", "userId", "status"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Single common student group doubt discussion post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "enum": ["student", "admin"] },
        "authorAvatar": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 250 },
        "content": { "type": "string", "maxLength": 3000 },
        "paperId": { "type": "string" },
        "chapterName": { "type": "string", "maxLength": 200 },
        "tags": { "type": "array" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "isPinned": { "type": "boolean" },
        "isResolved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "groupId", "authorId", "authorName", "title", "content"]
    },
    "CommunityReply": {
      "title": "CommunityReply",
      "description": "Reply or solution to discussion post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "enum": ["student", "admin"] },
        "authorAvatar": { "type": "string", "maxLength": 20 },
        "content": { "type": "string", "maxLength": 2000 },
        "likes": { "type": "number" },
        "likedBy": { "type": "array" },
        "isFacultySolution": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "authorName", "content"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "Report on post, reply, or user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "reply", "user"] },
        "targetId": { "type": "string" },
        "targetTitle": { "type": "string", "maxLength": 250 },
        "reportedBy": { "type": "string", "maxLength": 100 },
        "reportedByUid": { "type": "string" },
        "reason": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "targetType", "targetId", "reason", "status"]
    },
    "ExamAnnouncement": {
      "title": "ExamAnnouncement",
      "description": "Verified ICAI exam announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 250 },
        "summary": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string" },
        "category": { "type": "string", "maxLength": 100 },
        "officialPdfUrl": { "type": "string" },
        "isUrgent": { "type": "boolean" },
        "publishedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "summary", "date", "category"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Student UPI verification claim for ₹5 monthly pass",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 100 },
        "studentEmail": { "type": "string", "format": "email" },
        "studentMobile": { "type": "string", "maxLength": 15 },
        "paymentReference": { "type": "string", "maxLength": 40 },
        "amount": { "type": "number" },
        "planType": { "type": "string" },
        "utr": { "type": "string", "maxLength": 40 },
        "screenshotUrl": { "type": "string", "maxLength": 750000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNotes": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 100 },
        "reviewedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "unlockedUntil": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "studentMobile", "amount", "utr", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "In-app admin and student notification alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "relatedId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientId", "title", "message", "type", "read"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Authentic visit, login, signup, and study telemetry events for Admin analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "visitorId": { "type": "string", "maxLength": 80 },
        "eventType": { "type": "string", "enum": ["visit", "login", "signup", "study_session", "payment_submit"] },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "visitorId", "eventType", "date"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Owner administrative audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 1000 },
        "performedBy": { "type": "string", "maxLength": 150 },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "action", "details", "performedBy", "timestamp"]
    },
    "UpiConfig": {
      "title": "UpiConfig",
      "description": "Admin payment QR & UPI ID configuration",
      "type": "object",
      "properties": {
        "upiId": { "type": "string", "maxLength": 80 },
        "payeeName": { "type": "string", "maxLength": 100 },
        "qrCodeImageUrl": { "type": "string" },
        "defaultAmount": { "type": "number" },
        "monthlyAmount": { "type": "number" }
      },
      "required": ["upiId", "payeeName", "defaultAmount", "monthlyAmount"]
    },
    "ExamCountdownConfig": {
      "title": "ExamCountdownConfig",
      "description": "Configurable CA Foundation exam attempt and verified date",
      "type": "object",
      "properties": {
        "examName": { "type": "object" },
        "examDate": { "type": "string" },
        "targetAttempt": { "type": "string" },
        "adminAlertNote": { "type": "object" },
        "isDateVerified": { "type": "boolean" }
      },
      "required": ["targetAttempt", "isDateVerified"]
    },
    "SubjectChapter": {
      "title": "SubjectChapter",
      "description": "Configurable syllabus chapter item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paperId": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "title": { "type": "object" }
      },
      "required": ["id", "paperId", "chapterNumber", "title"]
    },
    "CustomQuestion": {
      "title": "CustomQuestion",
      "description": "Admin-managed MCQ or PYQ question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paperId": { "type": "string" },
        "chapterId": { "type": "string" },
        "difficulty": { "type": "string" }
      },
      "required": ["id", "paperId", "chapterId", "difficulty"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Admin-managed CA Foundation revision notes & study material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paperId": { "type": "string" },
        "chapterTitle": { "type": "object" },
        "topicTitle": { "type": "object" },
        "readTimeMinutes": { "type": "number" },
        "tags": { "type": "array" },
        "summary": { "type": "object" },
        "keyPoints": { "type": "array" }
      },
      "required": ["id", "paperId", "chapterTitle", "topicTitle", "summary"]
    },
    "AIChatMessage": {
      "title": "AIChatMessage",
      "description": "Individual student multi-turn conversation message with CA Saathi AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string", "maxLength": 16000 },
        "paperId": { "type": "string", "enum": ["all", "paper1", "paper2", "paper3", "paper4"] },
        "language": { "type": "string", "enum": ["en", "hi", "hinglish"] },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "role", "content", "paperId", "language", "createdAt"]
    },
    "NoteMaterial": {
      "title": "NoteMaterial",
      "description": "Uploaded PDF notes, handwritten notes, practice materials, PYQs, and mock papers with approval workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1500 },
        "paperId": { "type": "string", "enum": ["paper1", "paper2", "paper3", "paper4"] },
        "chapterId": { "type": "string", "maxLength": 120 },
        "chapterNumber": { "type": "number" },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "attempt": { "type": "string", "enum": ["January 2027", "May 2027", "Both"] },
        "category": {
          "type": "string",
          "enum": [
            "Chapter-wise Notes",
            "Handwritten Notes",
            "Practice Material",
            "Important Questions",
            "Previous Year Questions",
            "Mock Tests"
          ]
        },
        "fileName": { "type": "string", "maxLength": 200 },
        "storageFileName": { "type": "string", "maxLength": 200 },
        "fileUrl": { "type": "string", "maxLength": 500 },
        "fileSizeBytes": { "type": "number" },
        "mimeType": { "type": "string" },
        "uploaderId": { "type": "string", "maxLength": 128 },
        "uploaderName": { "type": "string", "maxLength": 100 },
        "uploaderEmail": { "type": "string", "maxLength": 150 },
        "uploaderRole": { "type": "string", "enum": ["admin", "student"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 150 },
        "reviewedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id", "title", "paperId", "chapterId", "chapterNumber", "chapterTitle",
        "attempt", "category", "fileName", "storageFileName", "fileUrl",
        "fileSizeBytes", "mimeType", "uploaderId", "uploaderName", "uploaderRole",
        "status", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual student profile with settings and verified membership fields"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Student tracked active study sessions"
    },
    "/users/{userId}/testResults/{testResultId}": {
      "schema": "TestResult",
      "description": "User specific test attempts and scores"
    },
    "/users/{userId}/wrongQuestions/{questionId}": {
      "schema": "WrongQuestion",
      "description": "Wrong question notebook entries"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User bookmarked question references"
    },
    "/users/{userId}/studyTasks/{taskId}": {
      "schema": "StudyTask",
      "description": "User daily study checklist tasks"
    },
    "/users/{userId}/revisionReminders/{reminderId}": {
      "schema": "RevisionReminder",
      "description": "User spaced repetition reminders"
    },
    "/users/{userId}/chapterProgress/{chapterId}": {
      "schema": "ChapterProgress",
      "description": "User syllabus chapter completion states"
    },
    "/users/{userId}/aiChats/{messageId}": {
      "schema": "AIChatMessage",
      "description": "Individual multi-turn chat history with CA Saathi AI"
    },
    "/studyPresence/{userId}": {
      "schema": "StudyPresence",
      "description": "Non-PII live study presence for common student group"
    },
    "/posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Common student group doubt discussions"
    },
    "/posts/{postId}/replies/{replyId}": {
      "schema": "CommunityReply",
      "description": "Replies to discussion posts"
    },
    "/moderationReports/{reportId}": {
      "schema": "ModerationReport",
      "description": "Student reports and moderation complaints"
    },
    "/examAnnouncements/{announcementId}": {
      "schema": "ExamAnnouncement",
      "description": "Verified ICAI examination announcements"
    },
    "/paymentRequests/{paymentId}": {
      "schema": "PaymentRequest",
      "description": "Student ₹5 payment verification claims"
    },
    "/notifications/{notifId}": {
      "schema": "AppNotification",
      "description": "Admin and student real-time notifications & broadcasts"
    },
    "/analyticsEvents/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Visitor, login, signup, and study events for Admin analytics"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin audit trail entries"
    },
    "/upiConfig/{configId}": {
      "schema": "UpiConfig",
      "description": "Admin UPI ID and QR settings"
    },
    "/examCountdown/{configId}": {
      "schema": "ExamCountdownConfig",
      "description": "Admin-managed active CA Foundation attempt and date"
    },
    "/subjectChapters/{chapterId}": {
      "schema": "SubjectChapter",
      "description": "Admin-synced syllabus chapters"
    },
    "/customQuestions/{questionId}": {
      "schema": "CustomQuestion",
      "description": "Admin-added MCQs and PYQs"
    },
    "/studyMaterials/{materialId}": {
      "schema": "StudyNote",
      "description": "Admin-managed revision notes and study materials"
    },
    "/noteMaterials/{noteId}": {
      "schema": "NoteMaterial",
      "description": "Structured PDF notes and study materials uploaded by Owner or permitted students with approval workflow"
    }
  }
}
